---
import Base from '../layouts/Base.astro';
---
<Base title="bravewaffles — building thoughtful apps">
  <main class="home">
      <section class="hero">
      <img class="hero-waffle hero-waffle-white" src="/bravewaffle-white-hero.png" width="300" height="300" alt="Bravewaffles waffle" />
      <img class="hero-waffle hero-waffle-black" src="/bravewaffle-black-hero.png" width="300" height="300" alt="Bravewaffles waffle" />
      <div class="hero-text">
        <h1>bravewaffles</h1>
        <p class="tagline">Building <span class="accent">thoughtful</span> apps for Mac and iPhone. Starting with notes.</p>
      </div>
    </section>
    <section class="projects">
      <h2>Projects</h2>
      <a class="project-pill" href="/consistent-notes">
        <img src="/menubar-icon.svg" width="18" height="18" alt="" class="pill-icon" />
        Consistent Notes
      </a>
    </section>
  </main>
</Base>
