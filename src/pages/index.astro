---
import Base from '../layouts/Base.astro';
---
<Base title="bravewaffles — apps and things">
  <main>
      <section class="hero">
      <img class="hero-black" src="/bravewaffle-black-hero.png" width="300" height="300" alt="Bravewaffles waffle" />
      <div class="hero-text">
        <h1>Brave Waffles</h1>
        <p class="tagline">Building <span class="accent">thoughtful</span> software for Mac and iPhone.</p>
      </div>
    </section>
    <section class="projects">
      <h2>Projects</h2>
      <div class="grid">
        <a class="card" href="/consistent-notes">
          <h3><img src="/menubar-icon.svg" width="20" height="20" alt="" class="card-icon" />Consistent Notes <span class="badge">macOS &middot; iOS</span></h3>
          <p>A menu bar notes app with streaks, heatmaps, todos, and vim motions. Notes sync between your Mac and iPhone over iCloud.</p>
        </a>
      </div>
    </section>
  </main>
</Base
