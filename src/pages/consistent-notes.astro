---
import Base from '../layouts/Base.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
import FeatureIcon from '../components/FeatureIcon.astro';
import {
  APP_STORE_MAC_URL, APP_STORE_IOS_URL, PRODUCT_NAME, PRODUCT_TAGLINE,
  PRICE_MONTHLY, PRICE_YEARLY, TRIAL_NOTE,
} from '../lib/site';

const features = [
  { icon: 'keyboard', name: 'Keyboard-first', body: 'Open it from anywhere, navigation and editing at your fingertips, hold Cmd to see shortcuts.' },
  { icon: 'pencil', name: 'Markdown editor', body: 'Syntax highlighting, auto-pairing, smart Home/End, and checkbox cascade.' },
  { icon: 'checklist', name: 'ToDos that roll over', body: 'Hierarchical todos, cross-day rollover, and cascade checking.' },
  { icon: 'flame', name: 'Streaks & heatmaps', body: 'Build a daily habit with streaks and a full-year heatmap view.' },
  { icon: 'command', name: 'Vim support', body: 'Move and editing with Vim motions everywhere, visual line movement, and hardcore mode.' },
  { icon: 'bell', name: 'Daily reminders', body: 'A gentle nudge via notifications when you want it.' },
  { icon: 'palette', name: '27 themes', body: 'Dracula, Solarized, Nord, Gruvbox, Monokai, and more.' },
  { icon: 'search', name: 'Search all notes', body: 'Instant search across every note (Cmd+Shift+F).' },
  { icon: 'document', name: 'Markdown export', body: 'Every note saves automatically as a dated .md file.' },
];
---
<Base title={`${PRODUCT_NAME} — a macOS menu bar journaling app`}>
  <main class="page">
    <div class="product-header">
      <div>
        <h1>{PRODUCT_NAME}</h1>
        <p class="tagline">{PRODUCT_TAGLINE}</p>
      </div>
      <img class="app-icon" src="/app-icon.svg" width="128" height="128" alt="Consistent Notes app icon" />
    </div>
    <div class="cta-row">
      <AppStoreBadge platform="mac" href={APP_STORE_MAC_URL} />
      <AppStoreBadge platform="ios" href={APP_STORE_IOS_URL} comingSoon />
    </div>

    <h2 class="section-title">Preview</h2>
    <div class="shots-grid">
      <figure class="shot">
        <img class="shot-dark" src="/screenshots/editor-view-dark.png" width="1012" height="1012" loading="lazy" decoding="async" alt="Consistent Notes editor view" />
        <img class="shot-light" src="/screenshots/editor-view-light.png" width="1012" height="1012" loading="lazy" decoding="async" alt="Consistent Notes editor view" />
        <figcaption>Editor view</figcaption>
      </figure>
      <figure class="shot">
        <img class="shot-dark" src="/screenshots/notes-list-dark.png" width="1012" height="1012" loading="lazy" decoding="async" alt="Consistent Notes notes list" />
        <img class="shot-light" src="/screenshots/notes-list-light.png" width="1012" height="1012" loading="lazy" decoding="async" alt="Consistent Notes notes list" />
        <figcaption>Notes list</figcaption>
      </figure>
      <figure class="shot">
        <img class="shot-dark" src="/screenshots/year-view-dark.png" width="1012" height="1012" loading="lazy" decoding="async" alt="Consistent Notes year heatmap view" />
        <img class="shot-light" src="/screenshots/year-view-light.png" width="1012" height="1012" loading="lazy" decoding="async" alt="Consistent Notes year heatmap view" />
        <figcaption>Year view</figcaption>
      </figure>
    </div>

    <h2 class="section-title">Features</h2>
    <div class="features">
      {features.map((f) => (
        <div class="feature">
          <h3><FeatureIcon icon={f.icon} />{f.name}</h3>
          <p>{f.body}</p>
        </div>
      ))}
    </div>

    <h2 class="section-title">Pricing</h2>
    <div class="pricing">
      <div class="price-card">
        <h3>Monthly</h3>
        <div class="price">{PRICE_MONTHLY}<span class="per">/mo</span></div>
        <span class="trial">{TRIAL_NOTE}</span>
      </div>
      <div class="price-card featured">
        <h3>Yearly</h3>
        <div class="price">{PRICE_YEARLY}<span class="per">/yr</span></div>
        <span class="trial">{TRIAL_NOTE}</span>
        <p class="price-note">Save 16% vs. monthly</p>
      </div>
    </div>

    <h2 class="section-title">Sync <span class="coming-soon-pill">Coming soon</span></h2>
    <p class="prose">Your notes live in the menu bar and sync between your Mac and iPhone over iCloud.</p>
  </main>
</Base>
